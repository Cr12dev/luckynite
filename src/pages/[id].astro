---
import Layout from '../layouts/Layout.astro';

const { id } = Astro.params;
---

<Layout title="LuckyNite">
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
		rel="stylesheet"
	/>
	<div id="black-container">
		<div class="content">
			<h2 class="gradient-text">Pickaxe Catwoman</h2>
			<p class="subtitle">Unredeemed Code</p>
			<div class="timer-container">
				<span class="timer-label">Next update in:</span>
				<span class="timer-display" id="global-timer">60s</span>
			</div>
			<div class="image-placeholder">
				<img src="/catwomanpickaxe.jpg" alt="Pickaxe Catwoman Cosmetic" />
			</div>
			<div class="codes">
				<div class="code-wrapper">
					<div class="code blurred" id="code-1"></div>
					<span class="countdown"></span>
				</div>
				<div class="code-wrapper">
					<div class="code blurred" id="code-2"></div>
					<span class="countdown"></span>
				</div>
				<div class="code-wrapper">
					<div class="code blurred" id="code-3"></div>
					<span class="countdown"></span>
				</div>
			</div>
			<p class="disclaimer">
				Once you view a code, you cannot see it again for 1 hour. We advise you to take a photo or write it down before the code disappears.
			</p>
		</div>
	</div>
	
</Layout>

<script>
	// Get current page ID from URL
	const currentPath = window.location.pathname;
	const currentId = currentPath.split('/').filter(part => part.length > 0).pop() || 'default';

	console.log('Current path:', currentPath);
	console.log('Current ID:', currentId);

	// Check if user has validated a TikTok URL with matching ID
	const hasValidated = sessionStorage.getItem('tiktokValidated');
	const storedId = sessionStorage.getItem('tiktokId');

	console.log('Validation check:', {
		hasValidated,
		storedId,
		currentId,
		idsMatch: storedId === currentId
	});

	if (!hasValidated || storedId !== currentId) {
		console.log('Redirecting to index - validation failed');
		// Redirect to landing page if not validated or ID doesn't match
		window.location.href = '/';
	} else {
		console.log('Validation passed, showing page');
	}

	// Function to generate random code
	function generateRandomCode() {
		const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
		let code = '';
		for (let i = 0; i < 4; i++) {
			code += chars.charAt(Math.floor(Math.random() * chars.length));
		}
		code += '-';
		for (let i = 0; i < 4; i++) {
			code += chars.charAt(Math.floor(Math.random() * chars.length));
		}
		code += '-';
		for (let i = 0; i < 4; i++) {
			code += chars.charAt(Math.floor(Math.random() * chars.length));
		}
		code += '-';
		for (let i = 0; i < 4; i++) {
			code += chars.charAt(Math.floor(Math.random() * chars.length));
		}
		return code;
	}

	// Generate random codes on page load
	document.getElementById('code-1').textContent = generateRandomCode();
	document.getElementById('code-2').textContent = generateRandomCode();
	document.getElementById('code-3').textContent = generateRandomCode();

	// Infinite 1-minute countdown timer
	let globalTimeLeft = 43200;
	const globalTimerDisplay = document.getElementById('global-timer');

	setInterval(() => {
		globalTimeLeft--;
		if (globalTimeLeft <= 0) {
			globalTimeLeft = 60;
		}
		globalTimerDisplay.textContent = `${globalTimeLeft}s`;
	}, 1000);

	// Function to update all codes with new random values
	function updateCodes() {
		const codes = document.querySelectorAll('.code');
		codes.forEach((code) => {
			// Only update if currently blurred
			if (code.classList.contains('blurred')) {
				code.textContent = generateRandomCode();
			}
		});
		console.log('Codes updated at:', new Date().toLocaleTimeString());
	}

	// Update codes every 1 minute (60,000ms)
	setInterval(updateCodes, 60000);

	// Reveal code on click with 10-second timer and 1-hour cooldown
	const codes = document.querySelectorAll('.code');
	codes.forEach((code, index) => {
		const codeId = `code-${index}`;

		code.addEventListener('click', () => {
			// Check if code is in cooldown
			const lastViewed = localStorage.getItem(codeId);
			const now = Date.now();
			const cooldownPeriod = 60 * 60 * 1000; // 1 hour in milliseconds

			if (lastViewed && (now - parseInt(lastViewed)) < cooldownPeriod) {
				const remainingTime = Math.ceil((cooldownPeriod - (now - parseInt(lastViewed))) / 60000);
				alert(`This code is on cooldown. You can view it again in ${remainingTime} minutes.`);
				return;
			}

			// Don't start new timer if already revealed
			if (!code.classList.contains('blurred')) return;

			code.classList.remove('blurred');

			// Store the timestamp when code was viewed
			localStorage.setItem(codeId, now.toString());

			// Get the countdown element from the wrapper
			const wrapper = code.parentElement;
			const countdown = wrapper.querySelector('.countdown');
			countdown.textContent = '10s';

			let timeLeft = 10;
			const timer = setInterval(() => {
				timeLeft--;
				countdown.textContent = `${timeLeft}s`;

				if (timeLeft <= 0) {
					clearInterval(timer);
					code.classList.add('blurred');
					countdown.textContent = '';
					// Re-blur and generate new code
					code.textContent = generateRandomCode();
				}
			}, 1000);
		});
	});
</script>

<style is:global>
	:global(body) {
		background-color: #000000;
		color: #ffffff;
		margin: 0;
		padding: 0;
		overflow: hidden;
	}
</style>

<style>
	#black-container {
		min-height: 100vh;
		width: 100%;
		background-color: #000000;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		padding: 2rem;
	}

	.content {
		text-align: center;
		max-width: 600px;
		width: 100%;
	}

	.gradient-text {
		font-size: 2.5rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 25%, #ec4899 50%, #8b5cf6 75%, #6366f1 100%);
		background-size: 300% 300%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: gradientShift 6s ease infinite;
		line-height: 1.2;
	}

	.subtitle {
		font-size: 1.25rem;
		color: #a1a1aa;
		margin: 0 0 1.5rem 0;
		font-weight: 400;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.timer-container {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 2rem;
		padding: 0.75rem 1.5rem;
		background: rgba(99, 102, 241, 0.1);
		border: 1px solid rgba(99, 102, 241, 0.3);
		border-radius: 12px;
	}

	.timer-label {
		font-size: 0.9rem;
		color: #a1a1aa;
		font-weight: 500;
	}

	.timer-display {
		font-size: 1.1rem;
		font-weight: 700;
		color: #6366f1;
		background: rgba(99, 102, 241, 0.2);
		padding: 0.25rem 0.75rem;
		border-radius: 6px;
		min-width: 60px;
		text-align: center;
	}

	@keyframes gradientShift {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}

	.image-placeholder {
		margin-bottom: 2rem;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(26, 26, 26, 0.5);
		min-height: 300px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.image-placeholder img {
		width: 100%;
		height: auto;
		display: block;
	}

	.codes {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 100%;
	}

	.code-wrapper {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
	}

	.code {
		flex: 1;
		padding: 1rem 1.5rem;
		font-size: 1.1rem;
		font-weight: 600;
		border: 1px solid rgba(99, 102, 241, 0.3);
		border-radius: 12px;
		background: rgba(26, 26, 26, 0.8);
		color: #ffffff;
		letter-spacing: 0.05em;
		transition: all 0.3s ease;
		filter: blur(8px);
		user-select: none;
		cursor: pointer;
	}

	.code:hover {
		border-color: #6366f1;
		box-shadow: 0 0 20px rgba(99, 102, 241, 0.2);
		transform: translateY(-2px);
	}

	.code.blurred {
		filter: blur(8px);
	}

	.code:not(.blurred) {
		filter: blur(0);
		user-select: text;
	}

	.countdown {
		min-width: 50px;
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: #ec4899;
		background: rgba(236, 72, 153, 0.1);
		border: 1px solid rgba(236, 72, 153, 0.3);
		border-radius: 8px;
		text-align: center;
		opacity: 0;
		transform: scale(0.9);
		transition: all 0.3s ease;
	}

	.countdown:not(:empty) {
		opacity: 1;
		transform: scale(1);
	}

	.disclaimer {
		font-size: 0.85rem;
		color: #71717a;
		margin-top: 1.5rem;
		line-height: 1.5;
		font-weight: 400;
		padding: 1rem;
		background: rgba(26, 26, 26, 0.3);
		border-radius: 8px;
		border: 1px solid rgba(255, 255, 255, 0.05);
	}

	@media (max-width: 768px) {
		#black-container {
			padding: 1.5rem;
		}

		.gradient-text {
			font-size: 1.75rem;
		}

		.subtitle {
			font-size: 1rem;
			margin: 0 0 1.5rem 0;
		}

		.image-placeholder {
			min-height: 200px;
			margin-bottom: 1.5rem;
		}

		.code {
			font-size: 1rem;
			padding: 0.875rem 1.25rem;
		}

		.countdown {
			min-width: 45px;
			padding: 0.4rem 0.875rem;
			font-size: 0.85rem;
		}
	}

	@media (max-width: 480px) {
		#black-container {
			padding: 1rem;
		}

		.content {
			max-width: 100%;
		}

		.gradient-text {
			font-size: 1.5rem;
		}

		.subtitle {
			font-size: 0.9rem;
			margin: 0 0 1.25rem 0;
		}

		.image-placeholder {
			min-height: 180px;
			margin-bottom: 1.25rem;
		}

		.code-wrapper {
			gap: 0.5rem;
		}

		.code {
			font-size: 0.9rem;
			padding: 0.75rem 1rem;
		}

		.countdown {
			min-width: 40px;
			padding: 0.35rem 0.75rem;
			font-size: 0.8rem;
		}
	}

	@media (max-width: 360px) {
		.gradient-text {
			font-size: 1.25rem;
		}

		.subtitle {
			font-size: 0.85rem;
		}

		.image-placeholder {
			min-height: 150px;
		}

		.code {
			font-size: 0.85rem;
			padding: 0.625rem 0.875rem;
		}

		.countdown {
			min-width: 35px;
			padding: 0.3rem 0.625rem;
			font-size: 0.75rem;
		}
	}
</style>
