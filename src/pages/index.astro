---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LuckyNite - Unused Fortnite Codes">
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
		rel="stylesheet"
	/>
	<div id="landing-container">
		<div class="orb orb-1"></div>
		<div class="orb orb-2"></div>
		<main class="content">
			<h1>LuckyNite</h1>
			<p class="subtitle">unused fortnite codes</p>
			<form id="tiktok-form">
				<input
					type="text"
					id="tiktok-url"
					placeholder="Enter Partner TikTok URL"
					autocomplete="off"
				/>
				<button type="submit" id="submit-btn">Submit</button>
			</form>
			<p id="error-message"></p>
		</main>
		<footer>
			<p>&copy; 2025 LuckyNite. All rights reserved.</p>
		</footer>
		<div id="loading-overlay" class="hidden">
			<div class="spinner"></div>
			<p>Loading...</p>
		</div>
	</div>
</Layout>

<script>
	const form = document.getElementById('tiktok-form') as HTMLFormElement;
	const input = document.getElementById('tiktok-url') as HTMLInputElement;
	const loadingOverlay = document.getElementById('loading-overlay') as HTMLElement;
	const errorMessage = document.getElementById('error-message') as HTMLElement;

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const url = input.value.trim();

		// Validate TikTok URL
		if (!url.includes('tiktok.com')) {
			errorMessage.textContent = 'Please enter a valid TikTok URL';
			errorMessage.style.display = 'block';
			return;
		}

		errorMessage.style.display = 'none';

		// Extract video ID from TikTok URL
		// Try different methods to get a unique identifier
		const urlParts = url.split('/').filter(part => part.length > 0);
		let videoId = urlParts[urlParts.length - 1] || 'default';

		// If the last part is empty or contains query params, try previous parts
		if (videoId === '' || videoId.includes('?') || videoId.includes('#')) {
			videoId = urlParts[urlParts.length - 2] || 'default';
		}

		// Remove any query parameters or fragments
		videoId = videoId.split('?')[0].split('#')[0];

		// If still empty or 'default', create a simple hash from the URL
		if (videoId === '' || videoId === 'default') {
			const hash = url.split('').reduce((acc, char) => {
				return ((acc << 5) - acc) + char.charCodeAt(0);
			}, 0);
			videoId = Math.abs(hash).toString(36);
		}

		console.log('Extracted video ID:', videoId);

		// Store validation state with video ID
		sessionStorage.setItem('tiktokValidated', 'true');
		sessionStorage.setItem('tiktokId', videoId);

		console.log('Stored in sessionStorage:', {
			tiktokValidated: sessionStorage.getItem('tiktokValidated'),
			tiktokId: sessionStorage.getItem('tiktokId')
		});

		// Show loading overlay
		loadingOverlay.classList.remove('hidden');

		// Simulate loading for 10 seconds then redirect to video ID
		setTimeout(() => {
			console.log('Redirecting to:', `/${videoId}`);
			window.location.href = `/${videoId}`;
		}, 10000);
	});

	input?.addEventListener('input', () => {
		errorMessage.style.display = 'none';
	});
</script>

<style is:global>
	:global(body) {
		background-color: #0a0a0a;
		color: #ffffff;
	}
</style>

<style>
	#landing-container {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(ellipse at top, #1a1a2e 0%, #0a0a0a 50%);
		font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		position: relative;
		overflow: hidden;
	}

	.orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.3;
		animation: float 12s ease-in-out infinite;
		pointer-events: none;
	}

	.orb-1 {
		width: 500px;
		height: 500px;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		top: -150px;
		left: -150px;
		animation-delay: 0s;
	}

	.orb-2 {
		width: 400px;
		height: 400px;
		background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
		bottom: -100px;
		right: -100px;
		animation-delay: 6s;
	}

	@keyframes float {
		0%,
		100% {
			transform: translate(0, 0);
		}
		50% {
			transform: translate(20px, -20px);
		}
	}

	.content {
		text-align: center;
		padding: 3rem 2.5rem;
		max-width: 480px;
		width: 100%;
		position: relative;
		z-index: 10;
		background: rgba(15, 15, 15, 0.7);
		backdrop-filter: blur(30px);
		-webkit-backdrop-filter: blur(30px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
	}

	footer {
		position: absolute;
		bottom: 1.5rem;
		left: 0;
		right: 0;
		text-align: center;
		z-index: 10;
		padding: 0 1rem;
	}

	footer p {
		font-size: 0.8rem;
		color: #52525b;
		margin: 0;
		font-weight: 400;
	}

	h1 {
		font-size: 4rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 25%, #ec4899 50%, #8b5cf6 75%, #6366f1 100%);
		background-size: 300% 300%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		letter-spacing: -0.02em;
		animation: gradientShift 6s ease infinite;
		line-height: 1.1;
	}

	@keyframes gradientShift {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}

	.subtitle {
		font-size: 1rem;
		color: #71717a;
		margin: 0 0 2.5rem 0;
		font-weight: 400;
		text-transform: lowercase;
		letter-spacing: 0.05em;
	}

	#tiktok-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	#tiktok-url {
		width: 100%;
		padding: 1rem 1.25rem;
		font-size: 0.95rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 10px;
		background-color: rgba(26, 26, 26, 0.6);
		color: #ffffff;
		outline: none;
		transition: all 0.2s ease;
		font-family: 'Space Grotesk', sans-serif;
		box-sizing: border-box;
	}

	#tiktok-url:focus {
		border-color: #6366f1;
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
		background-color: rgba(26, 26, 26, 0.9);
	}

	#tiktok-url::placeholder {
		color: #52525b;
		font-size: 0.9rem;
	}

	#submit-btn {
		width: 100%;
		padding: 1rem 1.25rem;
		font-size: 0.95rem;
		font-weight: 600;
		border: none;
		border-radius: 10px;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: #ffffff;
		cursor: pointer;
		transition: all 0.2s ease;
		font-family: 'Space Grotesk', sans-serif;
		box-sizing: border-box;
	}

	#submit-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(99, 102, 241, 0.35);
	}

	#submit-btn:active {
		transform: translateY(0);
	}

	#error-message {
		display: none;
		color: #ef4444;
		font-size: 0.875rem;
		margin-top: 0.5rem;
	}

	#loading-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(10, 10, 10, 0.95);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		z-index: 1000;
	}

	.hidden {
		display: none !important;
	}

	.spinner {
		width: 60px;
		height: 60px;
		border: 4px solid rgba(39, 39, 42, 0.3);
		border-top-color: #6366f1;
		border-right-color: #8b5cf6;
		border-radius: 50%;
		animation: spin 1s linear infinite;
		margin-bottom: 1.5rem;
		box-shadow: 0 0 30px rgba(99, 102, 241, 0.3);
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	#loading-overlay p {
		color: #a1a1aa;
		font-size: 1rem;
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 3rem;
		}

		.content {
			padding: 2.5rem 1.5rem;
		}

		.orb-1 {
			width: 350px;
			height: 350px;
			top: -100px;
			left: -100px;
		}

		.orb-2 {
			width: 300px;
			height: 300px;
			bottom: -75px;
			right: -75px;
		}

		footer {
			bottom: 1rem;
		}
	}

	@media (max-width: 480px) {
		h1 {
			font-size: 2.5rem;
		}

		.subtitle {
			font-size: 0.9rem;
		}

		.content {
			padding: 2rem 1rem;
			max-width: 100%;
		}

		.orb-1 {
			width: 300px;
			height: 300px;
			top: -100px;
			left: -100px;
		}

		.orb-2 {
			width: 250px;
			height: 250px;
			bottom: -75px;
			right: -75px;
		}

		footer {
			bottom: 0.75rem;
		}

		footer p {
			font-size: 0.75rem;
		}
	}

	@media (max-width: 360px) {
		h1 {
			font-size: 2rem;
		}

		.content {
			padding: 1.5rem 0.75rem;
		}

		#tiktok-url,
		#submit-btn {
			padding: 0.875rem 1rem;
			font-size: 0.875rem;
		}

		.orb-1,
		.orb-2 {
			display: none;
		}
	}
</style>
